# OpsMind 环境变量模板（保留 ECHOMIND_* 变量名以兼容现有部署）
# 用法：复制为 .env 后再修改。Windows PowerShell:  Copy-Item .env.example .env
# docker compose 会自动读取 .env（既用于 env_file 注入，也用于 ${REDIS_PASSWORD:-...} 变量替换）。
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ 三分钟配置指南（先读完这一段，其余按需改）                              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# 路线 A：Anthropic 官方 API
#   1) ANTHROPIC_API_KEY   填官方 key（sk-ant- 开头）
#   2) ANTHROPIC_MODEL     填官方模型名，例如 claude-3-5-sonnet-20241022
#   3) ANTHROPIC_BASE_URL  留空或删除本行（代码检测到为空时使用官方默认地址）
#
# 路线 B：DeepSeek 的 Anthropic 兼容接口（本项目默认，成本低）
#   1) ANTHROPIC_API_KEY   填 DeepSeek 控制台生成的 key（sk- 开头）
#   2) ANTHROPIC_MODEL     填你账号实际可用的模型，例如 deepseek-chat / deepseek-reasoner
#   3) ANTHROPIC_BASE_URL  保持 https://api.deepseek.com/anthropic
#
# ── 不配 key（或 key 仍是 xxx）时到底哪些功能能用？──────────────────────────
#   仍然可用（不依赖大模型）：
#     GET  /health          健康检查（返回 status=ok 与 Agent 统计）
#     GET  /skills          已加载的 Skills 摘要
#     GET  /monitor         监控摘要（Agent/工具统计、告警、优化建议）
#     GET  /knowledge/stats 知识库片段总数
#     GET  /metrics         Prometheus 指标
#   必然失败（必须调用大模型）：
#     POST /chat            主对话接口（key 无效时返回 LLM 鉴权/连接错误）
#     POST /search          检索链路含查询改写/重排（依赖大模型）
#     POST /eval/run        端到端评测（串行调用多次大模型）
#
#   ⚠ 典型误判：/health 返回 200 只能说明进程起来了，不代表聊天能用。
#     请用 scripts/smoke.ps1 冒烟（它把 /chat 单独列为可跳过项），
#     并先用 scripts/preflight.ps1 检查 .env 是否还是占位值。
#
# ── 其它说明 ───────────────────────────────────────────────────────────────
#   - 生产环境务必改掉 REDIS_PASSWORD，不要沿用示例值。
#   - 无外网机器无法构建镜像（Dockerfile 构建期要下载 ~79MB ONNX 模型），
#     需在有网机器 build 后 docker save / docker load，见 scripts/README.md。
# ───────────────────────────────────────────────────────────────────────────

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
# 【必须替换】xxx 是占位值：不改则 /chat /search /eval/run 全部失败。
# 官方 Anthropic 路线填 sk-ant-...；DeepSeek 路线填 DeepSeek 控制台的 key。
ANTHROPIC_API_KEY=xxx
# 【需确认】deepseek-v4-pro 是占位模型名，未必存在于你的账号；
# DeepSeek 官方可用 ID 为 deepseek-chat / deepseek-reasoner，
# Anthropic 官方路线则填 claude-3-5-sonnet-20241022 等真实模型名。
ANTHROPIC_MODEL=deepseek-v4-pro
# DeepSeek 的 Anthropic 兼容地址；走 Anthropic 官方路线时请留空或删除本行。
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
# 【建议修改】生产环境换成强口令；改这里即可，compose 会自动同步给容器。
REDIS_PASSWORD=echomind123
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:echomind123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
# 应用内 Prometheus 指标端口（0 表示不单独起端口，仅暴露 /metrics）
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
# 告警 webhook，留空表示不推送（当前仓库没有 grafana 服务，告警规则目录为空）
ALERT_WEBHOOK_URL=
